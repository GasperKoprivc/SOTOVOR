{$SOTOVOR_DOMAIN} {
	encode zstd gzip
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}
	reverse_proxy app:3000
}
