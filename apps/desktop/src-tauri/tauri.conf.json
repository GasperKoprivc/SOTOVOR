{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sotovor",
  "version": "0.1.0",
  "identifier": "si.sotovor.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": "default-src 'none'; style-src 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Gašper Koprivc",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    }
  }
}
