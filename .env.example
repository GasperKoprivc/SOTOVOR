SOTOVOR_PORT=3000
SOTOVOR_MONGO_PORT=27027
SOTOVOR_DB=sotovor
# Izbirna povezava z WhatsApp Cloud API
SOTOVOR_WHATSAPP_APP_SECRET=
SOTOVOR_WHATSAPP_VERIFY_TOKEN=
SOTOVOR_WHATSAPP_PHONE_ID=
# Izbirno za postavitev z javnim HTTPS. Za lokalni razvoj pusti SMTP izključen.
SOTOVOR_PUBLIC_URL=
SOTOVOR_REQUIRE_SMTP=0
SOTOVOR_SMTP_HOST=
SOTOVOR_SMTP_PORT=587
SOTOVOR_SMTP_USER=
SOTOVOR_SMTP_PASSWORD=
SOTOVOR_SMTP_FROM=
# Nastavi na 1 samo za enim zaupanja vrednim reverse proxyjem.
SOTOVOR_TRUST_PROXY=0
# Android update policy and App Links (comma-separated colon-delimited SHA-256 fingerprints).
SOTOVOR_ANDROID_PACKAGE=si.sotovor.app
SOTOVOR_ANDROID_FINGERPRINTS=
SOTOVOR_ANDROID_MIN_VERSION=0.1.0
SOTOVOR_ANDROID_LATEST_VERSION=0.1.0
SOTOVOR_MOBILE_ACCESS_SECONDS=600
# Optional Firebase Admin service account. Use JSON or an absolute path to a private file.
SOTOVOR_FCM_SERVICE_ACCOUNT_JSON=
SOTOVOR_FCM_SERVICE_ACCOUNT_FILE=
# Download catalog. A private GitHub repository needs a read-only Contents token.
SOTOVOR_RELEASE_REPOSITORY=GasperKoprivc/SOTOVOR
SOTOVOR_RELEASE_GITHUB_TOKEN=
SOTOVOR_GOOGLE_PLAY_URL=
SOTOVOR_RELEASE_FALLBACK_JSON=
SOTOVOR_RELEASE_FALLBACK_FILE=
