SOTOVOR_PORT=3000
SOTOVOR_MONGO_PORT=27027
SOTOVOR_DB=sotovor
# Izbirna povezava z WhatsApp Cloud API
SOTOVOR_WHATSAPP_APP_SECRET=
SOTOVOR_WHATSAPP_VERIFY_TOKEN=
SOTOVOR_WHATSAPP_PHONE_ID=
# Izbirno za postavitev z javnim HTTPS. Za lokalni razvoj pusti SMTP izključen.
SOTOVOR_PUBLIC_URL=
SOTOVOR_REQUIRE_SMTP=0
SOTOVOR_SMTP_HOST=
SOTOVOR_SMTP_PORT=587
SOTOVOR_SMTP_USER=
SOTOVOR_SMTP_PASSWORD=
SOTOVOR_SMTP_FROM=
# Nastavi na 1 samo za enim zaupanja vrednim reverse proxyjem.
SOTOVOR_TRUST_PROXY=0
# Android update policy and App Links (comma-separated colon-delimited SHA-256 fingerprints).
SOTOVOR_ANDROID_PACKAGE=si.sotovor.app
SOTOVOR_ANDROID_FINGERPRINTS=
SOTOVOR_ANDROID_MIN_VERSION=0.1.0
SOTOVOR_ANDROID_LATEST_VERSION=0.1.0
SOTOVOR_MOBILE_ACCESS_SECONDS=600
# Optional Firebase Admin service account. Use JSON or an absolute path to a private file.
SOTOVOR_FCM_SERVICE_ACCOUNT_JSON=
SOTOVOR_FCM_SERVICE_ACCOUNT_FILE=
# Download catalog. A private GitHub repository needs a read-only Contents token.
SOTOVOR_RELEASE_REPOSITORY=GasperKoprivc/SOTOVOR
SOTOVOR_RELEASE_GITHUB_TOKEN=
SOTOVOR_GOOGLE_PLAY_URL=
SOTOVOR_RELEASE_FALLBACK_JSON=
SOTOVOR_RELEASE_FALLBACK_FILE=

# Optional voice transcription using an OpenAI-compatible multipart endpoint.
SOTOVOR_TRANSCRIPTION_ENABLED=0
SOTOVOR_TRANSCRIPTION_URL=
SOTOVOR_TRANSCRIPTION_TOKEN=
SOTOVOR_TRANSCRIPTION_MODEL=whisper-1

# Sotovor Pro: default off unlocks everything; checkout UI is a later phase.
# Enabled billing requires PUBLIC_URL, provider and webhook secret. See docs/BILLING.md.
# Mock checkout is development-only. Production uses stripe.
# Limits: nonnegative integer or unlimited; feature flags: true / false.
SOTOVOR_BILLING_ENABLED=false
SOTOVOR_BILLING_PROVIDER=mock
# Generate a random 32-byte secret for mock; use Stripe whsec_... for stripe.
SOTOVOR_BILLING_WEBHOOK_SECRET=
# Stripe TEST keys first. Never commit a filled .env or send keys in chat.
SOTOVOR_STRIPE_SECRET_KEY=
# Distinct active recurring EUR 3/month and EUR 30/year prices, tax_behavior=inclusive.
SOTOVOR_STRIPE_PRICE_MONTHLY=
SOTOVOR_STRIPE_PRICE_YEARLY=
# Enable only after configuring Stripe Tax and reviewing tax obligations.
SOTOVOR_STRIPE_AUTOMATIC_TAX=false
# Human-reviewed UTF-8 terms required with live keys. Host path for start.bat;
# Compose: /app/legal/pogoji.txt, mapped from ./legal/pogoji.txt (not committed).
SOTOVOR_BILLING_TERMS_FILE=
SOTOVOR_LIMIT_FREE_MEMBERS=5
SOTOVOR_LIMIT_FREE_PLANNING_PROPOSALS=2
SOTOVOR_LIMIT_FREE_SHOPPING_LISTS=1
SOTOVOR_LIMIT_FREE_VOICE_NOTES=20
SOTOVOR_LIMIT_FREE_WHATSAPP=false
SOTOVOR_LIMIT_FREE_ICS=false
SOTOVOR_LIMIT_FREE_TRANSCRIPTION=false
SOTOVOR_LIMIT_FREE_ALL_TIME_STATISTICS=false
SOTOVOR_LIMIT_FREE_REWARDS=false
SOTOVOR_LIMIT_PRO_MEMBERS=12
SOTOVOR_LIMIT_PRO_PLANNING_PROPOSALS=unlimited
SOTOVOR_LIMIT_PRO_SHOPPING_LISTS=unlimited
SOTOVOR_LIMIT_PRO_VOICE_NOTES=unlimited
SOTOVOR_LIMIT_PRO_WHATSAPP=true
SOTOVOR_LIMIT_PRO_ICS=true
SOTOVOR_LIMIT_PRO_TRANSCRIPTION=true
SOTOVOR_LIMIT_PRO_ALL_TIME_STATISTICS=true
SOTOVOR_LIMIT_PRO_REWARDS=true
