# Copy to .env on the VPS. Keep that file private (chmod 600).
# Use a DNS hostname only, without https://, a port or a path.
# Compose derives the public HTTPS origin and sets the internal app port to 3000.
# It also enables SMTP and trusts its one Caddy proxy.
SOTOVOR_DOMAIN=sotovor.example.com

# Docker Hub image. Automated deployment pins the tested SHA in .release.env.
SOTOVOR_IMAGE=gasperkoprivc/sotovor:latest

# Mongo initialization runs only on a new volume. Use distinct passwords.
# Generate each password with: openssl rand -hex 32
# Leave these empty until filled. Keep app credentials URL-safe (hex recommended).
SOTOVOR_DB=sotovor
SOTOVOR_MONGO_ADMIN_USER=sotovor_admin
SOTOVOR_MONGO_ADMIN_PASSWORD=
SOTOVOR_MONGO_APP_USER=sotovor_app
SOTOVOR_MONGO_APP_PASSWORD=

# Verified SMTP sender. 587 uses required STARTTLS; 465 uses implicit TLS.
SOTOVOR_SMTP_HOST=smtp.example.com
SOTOVOR_SMTP_PORT=587
SOTOVOR_SMTP_USER=
SOTOVOR_SMTP_PASSWORD=
SOTOVOR_SMTP_FROM=no-reply@sotovor.example.com

# Optional WhatsApp Cloud API. Supply all three together to enable.
SOTOVOR_WHATSAPP_APP_SECRET=
SOTOVOR_WHATSAPP_VERIFY_TOKEN=
SOTOVOR_WHATSAPP_PHONE_ID=

# Optional Android App Links, update policy and Firebase push.
SOTOVOR_ANDROID_PACKAGE=si.sotovor.app
SOTOVOR_ANDROID_FINGERPRINTS=
SOTOVOR_ANDROID_MIN_VERSION=0.1.0
SOTOVOR_ANDROID_LATEST_VERSION=0.1.0
SOTOVOR_MOBILE_ACCESS_SECONDS=600
# Use single quotes around one-line JSON so Compose reads it literally.
SOTOVOR_FCM_SERVICE_ACCOUNT_JSON=
# Release catalog and anonymous downloads from the private release repository.
SOTOVOR_RELEASE_REPOSITORY=GasperKoprivc/SOTOVOR
SOTOVOR_RELEASE_GITHUB_TOKEN=
SOTOVOR_GOOGLE_PLAY_URL=
# Optional. See docs/DEPLOY.md for the public fallback JSON format.
SOTOVOR_RELEASE_FALLBACK_JSON=
# For a mounted service account file, set SOTOVOR_FCM_SERVICE_ACCOUNT_FILE in the app container's environment.

# Backup script settings are shell variables, set in cron if overriding defaults:
# SOTOVOR_BACKUP_DIR=/home/sotovor/backups
# SOTOVOR_BACKUP_RETENTION_DAYS=14
# SOTOVOR_ENV_FILE=/opt/sotovor/.env (default: .env in the project)
# SOTOVOR_RELEASE_FILE=/opt/sotovor/.release.env (default: .release.env in the project)
# COMPOSE_PROJECT_NAME=sotovor (default: sotovor)
